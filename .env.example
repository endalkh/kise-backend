# For running the backend OUTSIDE docker compose (e.g. `make run` against a local Postgres).
# The full stack is configured by the repository-root .env instead — see ../.env.example.
# Copy to backend/.env and change the secret before running anywhere but localhost.
KISE_SECRET_KEY=change-me-to-a-long-random-string
# PostgreSQL, using the psycopg 3 driver. Matches the docker-compose service below.
KISE_DATABASE_URL=postgresql+psycopg://kise:kise@localhost:5432/kise
KISE_ACCESS_TOKEN_EXPIRE_MINUTES=10080
KISE_DEFAULT_CURRENCY=ETB
KISE_CORS_ORIGINS=["*"]
# The landing page's download buttons. Each renders only when set; leave all three empty until a
# public build exists (the page then shows "coming soon").
KISE_APP_STORE_URL=
KISE_PLAY_STORE_URL=
# A direct link — an APK, a TestFlight invite, a GitHub release.
KISE_APP_DOWNLOAD_URL=
